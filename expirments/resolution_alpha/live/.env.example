# Copy to .env and export before running runner.py (this project doesn't
# auto-load .env files -- e.g. `set -a; source .env; set +a` in bash, or your
# process manager of choice).

# Required for the websocket feed (ws_feed.py -- order book + BTC/ETH settlement
# index) AND for placing real orders when RESOLUTION_ALPHA_DRY_RUN=false. Without
# these, runner.py still works, just falls back to REST polling / Coinbase spot
# for everything.
# On Windows: use forward slashes in KALSHI_PRIVATE_KEY_PATH (D:/path/to/key.txt),
# not backslashes -- `set -a; source .env; set +a` in bash silently strips
# backslashes as escape characters and breaks the path (see live/README.md).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Master safety switch -- defaults to true (log-only, no real orders) if unset.
RESOLUTION_ALPHA_DRY_RUN=true

# Disable the autonomous equity-loss kill-switch. Read by the start_live
# launchers only (start_live.sh / start_live.ps1), NOT by runner.py. When set
# truthy (1/true/yes/on, case-insensitive) the pnl_killswitch watcher is not
# armed and runner.py runs with no automatic stop if account equity drops.
# Off by default -- opt out deliberately; the runner is then unsupervised.
# RESOLUTION_ALPHA_DISABLE_KILLSWITCH=true

# Optional tuning -- see config.py for defaults and meaning.
# RESOLUTION_ALPHA_ENTRY_WINDOW_SECONDS=90
# RESOLUTION_ALPHA_MIN_PROB=0.97
# RESOLUTION_ALPHA_MIN_EDGE=0.02
# RESOLUTION_ALPHA_POLL_INTERVAL_SECONDS=2
# RESOLUTION_ALPHA_DISCOVERY_INTERVAL_SECONDS=60

# Which underlyings are actually tradeable -- defaults to BTC,ETH only (the
# only two with a real settlement-index feed via ws_feed.py, not a Coinbase
# proxy). See config.py's TRUSTED_SETTLEMENT_UNDERLYINGS docstring: every
# live loss so far has been on a proxy-fed underlying (BNB, NEAR). Don't
# widen this until proxy basis risk is actually measured.
# RESOLUTION_ALPHA_TRUSTED_UNDERLYINGS=BTC,ETH

# Whether to scan and trade "unsafe" markets -- any underlying not in
# TRUSTED_UNDERLYINGS above (i.e. Coinbase-proxy-fed, not real settlement
# index). Off by default: with it off, discovery only fetches the trusted
# underlyings' series, so the loop never wastes discovery calls / spot polls
# / order-book subscriptions / per-tick evaluation on the ~20 other live
# crypto series it would only skip anyway. Turn on to actually scan + trade
# them (re-exposes the proxy basis risk). See config.py's
# TRADE_UNSAFE_MARKETS docstring.
# RESOLUTION_ALPHA_TRADE_UNSAFE_MARKETS=true

# Position sizing is dynamic (Kelly, off model edge + account balance, see
# runner.py's _kelly_contracts) as of 2026-08-06, not a fixed contract count.
# These are hard ceilings the dynamic size gets clipped to, plus the Kelly
# fraction itself -- see config.py's docstrings before changing any of these.
# RESOLUTION_ALPHA_TARGET_CONTRACTS=10          # max contracts per market (ceiling)
# RESOLUTION_ALPHA_MAX_CYCLE_CONTRACTS=100       # max contracts per 15-min bucket (ceiling)
# RESOLUTION_ALPHA_KELLY_FRACTION=0.5            # fraction of full Kelly to size at
# RESOLUTION_ALPHA_KELLY_USE_MARKET_PROB=false   # Kelly sizes off market top-of-book prob, not the model (see config.py)
# RESOLUTION_ALPHA_DRY_RUN_BALANCE=1000          # simulated bankroll for dry-run sizing only

# Log the full per-candidate detail line (spot/strike/probs/edge) even when the
# candidate doesn't trade. Off by default: that line logs at INFO only when it
# leads to an order, at DEBUG otherwise, so a quiet-but-active window no longer
# fills the log with near-miss "edge/contract=-0.00xx" lines the 60s eval
# summary's low_edge counter already accounts for. See config.py's
# LOG_NONTRADING_CANDIDATES docstring.
# RESOLUTION_ALPHA_LOG_NONTRADING_CANDIDATES=true

# Only matters when another expirments/* strategy is ALSO trading this same
# Kalshi account live at the same time (they all share one KALSHI_API_KEY_ID).
# Fraction of the real account balance this experiment's Kelly sizing may
# treat as its own bankroll -- defaults to 1.0 (no partitioning). See
# ../../../prediction_market_scraper/Clients/Kalshi/README.md's "Capital allocation" before running more
# than one experiment live together.
# RESOLUTION_ALPHA_CAPITAL_FRACTION=0.5
# RESOLUTION_ALPHA_CAPITAL_CAP_DOLLARS=500

# Lightweight mode -- off by default. When on, the loop sleeps through most of
# each 15-minute interval instead of running continuously, waking only for the
# wake window below before each interval's close: the first half (down to the
# trading window below) only warms up spot/index history + subscriptions, the
# second half runs full trade evaluation. Suppresses ALL logging for as long
# as it's on. See config.py's LIGHTWEIGHT_MODE docstring.
# RESOLUTION_ALPHA_LIGHTWEIGHT_MODE=true
# RESOLUTION_ALPHA_LIGHTWEIGHT_WAKE_WINDOW_SECONDS=180
# RESOLUTION_ALPHA_LIGHTWEIGHT_TRADING_WINDOW_SECONDS=90
