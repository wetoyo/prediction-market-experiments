# Copy to .env. start_live.ps1 / start_live.sh load this into the process
# environment before launching ../strategy.py (this project doesn't
# auto-load .env otherwise).

# Required only for real order placement (GOLF_FIELD_ALPHA_DRY_RUN=false).
# Discovery + scanning work with no credentials at all.
# On Windows: use forward slashes in KALSHI_PRIVATE_KEY_PATH
# (D:/path/to/key.txt) -- bash's `source .env` silently strips backslashes.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Master safety switch -- defaults to true (log-only, no real orders) if unset.
GOLF_FIELD_ALPHA_DRY_RUN=true

# Which selection method --execute actually trades ("devig_edge" or
# "favorites_basket"). Both are always printed on every scan regardless.
# GOLF_FIELD_ALPHA_SELECTION_METHOD=devig_edge

# The fixed edge threshold (dollars per contract of payoff). See config.py.
# GOLF_FIELD_ALPHA_EDGE_THRESHOLD=0.03

# De-vig method: "proportional" or "power" (power pulls longshots down harder).
# GOLF_FIELD_ALPHA_DEVIG_METHOD=proportional

# Price band a leg must fall in to be bought (de-vig still normalises over
# the whole field). Sizing + risk caps.
# GOLF_FIELD_ALPHA_MIN_PRICE=0.02
# GOLF_FIELD_ALPHA_MAX_PRICE=0.90
# GOLF_FIELD_ALPHA_MIN_FIELD_SIZE=12
# GOLF_FIELD_ALPHA_MAX_OVERROUND=1.40
# GOLF_FIELD_ALPHA_MIN_SECONDS_TO_CLOSE=21600
# GOLF_FIELD_ALPHA_MAX_SECONDS_TO_CLOSE=864000
# GOLF_FIELD_ALPHA_KELLY_FRACTION=0.10
# GOLF_FIELD_ALPHA_MAX_CONTRACTS_PER_PLAYER=20
# GOLF_FIELD_ALPHA_MAX_EVENT_COST_DOLLARS=40
# GOLF_FIELD_ALPHA_DRY_RUN_BALANCE=1000

# Rescan cadence for the looping --execute process (start_live.* reads this).
# GOLF_FIELD_ALPHA_LOOP_SECONDS=300
