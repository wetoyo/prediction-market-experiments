# Copy to .env. start_live.* and the systemd unit load it. Plain KEY=VALUE, no quotes.

# Needed only for real orders. Scanning needs no credentials.
# Forward slashes on Windows too.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Master switch. Unset = dry-run (logs orders, places none).
WEATHER_LOCK_DRY_RUN=true

# Which series. Empty = every daily KXHIGH*/KXLOW* series with a known station.
# WEATHER_LOCK_SERIES=KXHIGHNY,KXHIGHCHI
# WEATHER_LOCK_EXCLUDE_SERIES=

# Lock safety: degrees F taken off the observed bound, and how many reports must reach it.
# WEATHER_LOCK_MARGIN_F=1.0
# WEATHER_LOCK_MIN_CONFIRMING_OBS=2

# Entry and caps.
# WEATHER_LOCK_MIN_EDGE=0.02
# WEATHER_LOCK_MAX_CONTRACTS_PER_MARKET=25
# WEATHER_LOCK_MAX_COST_PER_MARKET=20
# WEATHER_LOCK_MAX_COST_PER_EVENT=40
# WEATHER_LOCK_MAX_TOTAL_OPEN_COST=150
# WEATHER_LOCK_MAX_BANKROLL_FRACTION=0.25
# WEATHER_LOCK_LOOP_SECONDS=60

# NWS asks for a User-Agent naming the client.
# WEATHER_LOCK_NWS_USER_AGENT=weather-lock-runner/0.1

# Per-runner bankroll, to share the account with the other runners
# (see ../../MULTI_RUNNER_HANDOFF.md).
# WEATHER_LOCK_SIM_BANKROLL_ENABLED=true
# WEATHER_LOCK_SIZE_FROM_SIM_BANKROLL=true
# WEATHER_LOCK_SIM_BANKROLL_SHARED_ACCOUNT=true
# WEATHER_LOCK_SIM_BANKROLL_ALLOCATION_DOLLARS=
# WEATHER_LOCK_ORDER_TAG=wl
