[Unit]
Description=weather_lock live Kalshi runner
After=network-online.target time-sync.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=wetoyo
WorkingDirectory=/home/wetoyo/prediction-market-experiments/experiments/weather_lock
EnvironmentFile=/home/wetoyo/prediction-market-experiments/experiments/weather_lock/live/.env
ExecStart=/home/wetoyo/prediction-market-experiments/.venv/bin/python -u strategy.py --loop 60 --execute
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=SIGTERM SIGKILL

[Install]
WantedBy=multi-user.target
